{
  "name": "LaVivion",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "build-storybook": "storybook build",
    "dev": "nuxt dev",
    "eslint": "eslint --max-warnings=0",
    "eslint:fix": "eslint --max-warnings=0 --fix",
    "generate": "nuxt generate",
    "postinstall": "husky && nuxt prepare",
    "prettier": "prettier --check --ignore-unknown --no-error-on-unmatched-pattern . --experimental-cli",
    "prettier:write": "prettier --write --ignore-unknown --no-error-on-unmatched-pattern . --experimental-cli",
    "preview": "nuxt preview",
    "storybook": "storybook dev -p 6006",
    "tokens": "node scripts/build-tokens.mjs",
    "typecheck": "nuxt typecheck -b"
  },
  "nano-staged": {
    "*.{vue,js,jsx,cjs,mjs,ts,json,yaml}": "eslint --cache --fix --no-warn-ignored",
    "*": "prettier --write --ignore-unknown --experimental-cli"
  },
  "prettier": "@exer7um/prettier-config",
  "dependencies": {
    "@nuxt/icon": "2.5.1",
    "nuxt": "4.4.8",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@exer7um/eslint-config": "2.3.0",
    "@exer7um/prettier-config": "0.8.7",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/image": "^2.1.0",
    "@nuxtjs/storybook": "9.0.1",
    "@types/node": "^26.5.0",
    "husky": "9.1.7",
    "nano-staged": "1.0.2",
    "sass-embedded": "^1.104.0",
    "storybook": "10.4.6",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.3.11"
  },
  "trustedDependencies": [
    "@exer7um/eslint-config",
    "@parcel/watcher",
    "esbuild",
    "unrs-resolver"
  ]
}
